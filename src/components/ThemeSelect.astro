---
import DefaultThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
---

<div class="rad-header-controls">
  <button
    type="button"
    class="rad-header-button rad-collapse-all"
    id="rad-collapse-all"
    aria-label="Collapse all contents sections"
    title="Collapse all contents sections"
  >
    <span aria-hidden="true">▲</span>
  </button>

  <button
    type="button"
    class="rad-header-button rad-sidebar-toggle"
    id="rad-toggle-left"
    aria-label="Hide contents sidebar"
    aria-pressed="true"
    title="Toggle contents sidebar"
  >
    <span aria-hidden="true">☰</span>
  </button>

  <button
    type="button"
    class="rad-header-button rad-sidebar-toggle rad-right-sidebar-toggle"
    id="rad-toggle-right"
    aria-label="Hide page navigation"
    aria-pressed="true"
    title="Toggle page navigation"
  >
    <span aria-hidden="true">☷</span>
  </button>

  <div class="rad-learning-controls">
    <select id="rad-learning-mode" aria-label="Learning mode">
      <option value="reference">Complete Reference</option>
      <option value="trivia">Trivia</option>
      <option value="differentials">Differentials</option>
      <option value="mcq">MCQ</option>
      <option value="custom">Custom Revision</option>
    </select>

    <fieldset id="rad-learning-categories" hidden>
      <legend>Include categories</legend>
      <label><input type="checkbox" value="trivia" checked /> Trivia</label>
      <label><input type="checkbox" value="differentials" checked /> Differentials</label>
      <label><input type="checkbox" value="mcq" /> MCQ</label>
    </fieldset>

    <DefaultThemeSelect />
  </div>
</div>

<script>
  const MODE_KEY = 'rad4notes-learning-mode';
  const CATEGORIES_KEY = 'rad4notes-learning-categories';
  const SIDEBAR_KEY = 'rad4notes-sidebar-preferences';

  const VALID_MODES = ['reference', 'trivia', 'differentials', 'mcq', 'custom'];
  const VALID_CATEGORIES = ['trivia', 'differentials', 'mcq'];
  const DEFAULT_CATEGORIES = ['trivia', 'differentials'];

  function readCategories() {
    try {
      const saved = JSON.parse(localStorage.getItem(CATEGORIES_KEY) || 'null');
      return Array.isArray(saved)
        ? saved.filter((item) => VALID_CATEGORIES.includes(item))
        : [...DEFAULT_CATEGORIES];
    } catch {
      return [...DEFAULT_CATEGORIES];
    }
  }

  function readSidebarPreferences() {
    const defaults = { left: true, right: true };
    try {
      const saved = JSON.parse(localStorage.getItem(SIDEBAR_KEY) || 'null');
      if (!saved || typeof saved !== 'object') return defaults;
      return {
        left: saved.left !== false,
        right: saved.right !== false,
      };
    } catch {
      return defaults;
    }
  }

  function applySidebarPreferences(preferences) {
    const root = document.documentElement;

    // These preferences affect the custom desktop/tablet layout only.
    root.dataset.radLeftSidebarHidden = String(!preferences.left);
    root.dataset.radRightSidebarHidden = String(!preferences.right);

    const leftButton = document.querySelector('#rad-toggle-left');
    const rightButton = document.querySelector('#rad-toggle-right');

    if (leftButton) {
      leftButton.setAttribute('aria-pressed', String(preferences.left));
      leftButton.setAttribute(
        'aria-label',
        preferences.left ? 'Hide contents sidebar' : 'Show contents sidebar',
      );
      leftButton.title = preferences.left ? 'Hide contents sidebar' : 'Show contents sidebar';
    }

    if (rightButton) {
      rightButton.setAttribute('aria-pressed', String(preferences.right));
      rightButton.setAttribute(
        'aria-label',
        preferences.right ? 'Hide page navigation' : 'Show page navigation',
      );
      rightButton.title = preferences.right ? 'Hide page navigation' : 'Show page navigation';
    }

    try {
      localStorage.setItem(SIDEBAR_KEY, JSON.stringify(preferences));
    } catch {
      // The controls still work for the current page if storage is unavailable.
    }
  }

  function moveHeaderControls() {
    const titleWrapper = document.querySelector('.title-wrapper');
    if (!titleWrapper) return;

    const collapseButton = document.querySelector('#rad-collapse-all');
    const leftButton = document.querySelector('#rad-toggle-left');

    // Keep the collapse and left-sidebar controls beside the site title.
    // The right-TOC control stays in this component's header-tools position,
    // immediately after Search and before the learning controls.
    if (collapseButton && collapseButton.parentElement !== titleWrapper) {
      titleWrapper.append(collapseButton);
    }
    if (leftButton && leftButton.parentElement !== titleWrapper) {
      titleWrapper.append(leftButton);
    }
  }

  function getContentsRoot(sidebar) {
    return Array.from(sidebar.querySelectorAll('details')).find((group) => {
      const summary = Array.from(group.children).find(
        (child) => child.tagName === 'SUMMARY',
      );
      return summary?.textContent.trim().toLowerCase() === 'contents';
    });
  }

  function prepareSidebarNavigation() {
    const sidebar = document.querySelector('.sidebar-content');
    if (!sidebar) return;
    const contentsRoot = getContentsRoot(sidebar);
    if (contentsRoot) {
      contentsRoot.dataset.radContentsRoot = 'true';
      contentsRoot.open = true;
    }
  }

  function collapseAllSidebarSections() {
    // Starlight may render separate desktop and mobile sidebar trees.
    // Collapse every copy so the visible drawer always reflects the action.
    document.querySelectorAll('.sidebar-content').forEach((sidebar) => {
      const contentsRoot = getContentsRoot(sidebar);
      if (contentsRoot) {
        contentsRoot.dataset.radContentsRoot = 'true';
        contentsRoot.open = true;
      }

      sidebar.querySelectorAll('details').forEach((group) => {
        if (group === contentsRoot) return;
        group.open = false;
        group.removeAttribute('open');
      });
    });
  }

  let mcqCounter = 0;

  function enhanceMcqs() {
    document
      .querySelectorAll('.rad-learning-block--mcq:not([data-mcq-enhanced])')
      .forEach((block) => {
        const correctAnswer = Number(block.getAttribute('data-correct-answer'));
        const question = block.querySelector(':scope > p');
        const optionsList = block.querySelector(':scope > ol');
        const explanation = Array.from(block.children).find(
          (element) =>
            element.tagName === 'P' &&
            element.textContent.trim().startsWith('Explanation:'),
        );

        if (
          !question ||
          !optionsList ||
          !Number.isInteger(correctAnswer) ||
          correctAnswer < 1 ||
          correctAnswer > optionsList.children.length
        ) {
          return;
        }

        block.dataset.mcqEnhanced = 'true';

        const form = document.createElement('div');
        form.className = 'rad-mcq-form';

        const fieldset = document.createElement('fieldset');
        fieldset.className = 'rad-mcq-options';

        const legend = document.createElement('legend');
        legend.textContent = 'Select one answer';
        fieldset.append(legend);

        const optionLabels = [];
        const groupName = `rad-mcq-${++mcqCounter}`;

        Array.from(optionsList.children).forEach((item, index) => {
          const label = document.createElement('label');
          label.className = 'rad-mcq-option';

          const radio = document.createElement('input');
          radio.type = 'radio';
          radio.name = groupName;
          radio.value = String(index + 1);

          const text = document.createElement('span');
          text.textContent = item.textContent.trim();

          label.append(radio, text);
          fieldset.append(label);
          optionLabels.push(label);
        });

        const submit = document.createElement('button');
        submit.type = 'button';
        submit.className = 'rad-mcq-submit';
        submit.textContent = 'Submit Answer';

        const feedback = document.createElement('div');
        feedback.className = 'rad-mcq-feedback';
        feedback.setAttribute('aria-live', 'polite');

        form.append(fieldset, submit, feedback);
        optionsList.replaceWith(form);

        if (explanation) {
          explanation.hidden = true;
          explanation.classList.add('rad-mcq-explanation');
        }

        submit.addEventListener('click', () => {
          const selected = fieldset.querySelector('input[type="radio"]:checked');

          if (!selected) {
            feedback.textContent = 'Please select an answer first.';
            feedback.dataset.result = 'unanswered';
            return;
          }

          const selectedAnswer = Number(selected.value);
          const isCorrect = selectedAnswer === correctAnswer;
          feedback.replaceChildren();

          const result = document.createElement('strong');
          result.textContent = isCorrect
            ? 'Correct!'
            : 'Incorrect. The correct answer is:';
          feedback.append(result);

          if (!isCorrect) {
            const correctText = document.createElement('p');
            correctText.textContent = optionLabels[correctAnswer - 1].textContent.trim();
            feedback.append(correctText);
          }

          feedback.dataset.result = isCorrect ? 'correct' : 'incorrect';

          optionLabels.forEach((label, index) => {
            label.classList.toggle('is-correct', index + 1 === correctAnswer);
            label.classList.toggle(
              'is-incorrect',
              index + 1 === selectedAnswer && !isCorrect,
            );
          });

          fieldset.disabled = true;
          submit.disabled = true;
          submit.textContent = 'Answer Submitted';
          if (explanation) explanation.hidden = false;
        });
      });
  }

  function updateLearningContent(mode, categories) {
    const content = document.querySelector('.sl-markdown-content');
    if (!content) return;

    content.querySelector('.rad-learning-empty')?.remove();
    if (mode === 'reference') return;

    const selected = mode === 'custom' ? categories : [mode];
    const matchingBlocks = Array.from(
      content.querySelectorAll('.rad-learning-block'),
    ).filter((block) =>
      selected.some((category) =>
        block.classList.contains(`rad-learning-block--${category}`),
      ),
    );

    if (matchingBlocks.length) return;

    const empty = document.createElement('div');
    empty.className = 'rad-learning-empty';

    const heading = document.createElement('strong');
    const message = document.createElement('p');

    if (mode === 'custom') {
      heading.textContent = 'No selected learning material available';
      message.textContent =
        'There are currently no entries in the selected categories for this topic.';
    } else {
      const labels = {
        trivia: 'Testable Trivia',
        differentials: 'Differentials',
        mcq: 'MCQs',
      };
      heading.textContent = `No ${labels[mode]} available`;
      message.textContent = `There are currently no ${labels[mode]} entries for this topic.`;
    }

    empty.append(heading, message);
    content.append(empty);
  }

  function setLearningMode(mode) {
    if (!VALID_MODES.includes(mode)) return;

    const categories = readCategories();
    try {
      localStorage.setItem(MODE_KEY, mode);
    } catch {}

    document.querySelectorAll('#rad-learning-mode').forEach((selector) => {
      selector.value = mode;
    });
    document.querySelectorAll('#rad-learning-categories').forEach((panel) => {
      panel.hidden = mode !== 'custom';
    });

    document.documentElement.dataset.learningMode = mode;
    document.documentElement.dataset.learningTypes = categories.join(' ');
    updateLearningContent(mode, categories);
  }

  function setLearningCategories(sourceCheckbox) {
    const currentPanel = sourceCheckbox.closest('#rad-learning-categories');
    if (!currentPanel) return;

    const current = Array.from(
      currentPanel.querySelectorAll('input[type="checkbox"]'),
    )
      .filter((checkbox) => checkbox.checked)
      .map((checkbox) => checkbox.value)
      .filter((category) => VALID_CATEGORIES.includes(category));

    try {
      localStorage.setItem(CATEGORIES_KEY, JSON.stringify(current));
      localStorage.setItem(MODE_KEY, 'custom');
    } catch {}

    // Synchronize all copies, including controls rendered later in the mobile drawer.
    document.querySelectorAll('#rad-learning-categories').forEach((panel) => {
      panel.hidden = false;
      panel.querySelectorAll('input[type="checkbox"]').forEach((checkbox) => {
        checkbox.checked = current.includes(checkbox.value);
      });
    });
    document.querySelectorAll('#rad-learning-mode').forEach((selector) => {
      selector.value = 'custom';
    });

    document.documentElement.dataset.learningMode = 'custom';
    document.documentElement.dataset.learningTypes = current.join(' ');
    updateLearningContent('custom', current);
  }

  function initializeLearningMode() {
    const categories = readCategories();
    const savedMode = localStorage.getItem(MODE_KEY);
    const mode = VALID_MODES.includes(savedMode) ? savedMode : 'reference';

    // Set up every copy currently in the DOM. Interaction itself is delegated
    // from document, so controls inserted later by Starlight also work.
    document.querySelectorAll('#rad-learning-mode').forEach((selector) => {
      selector.value = mode;
    });
    document.querySelectorAll('#rad-learning-categories').forEach((panel) => {
      panel.hidden = mode !== 'custom';
      panel.querySelectorAll('input[type="checkbox"]').forEach((checkbox) => {
        checkbox.checked = categories.includes(checkbox.value);
      });
    });

    document.documentElement.dataset.learningMode = mode;
    document.documentElement.dataset.learningTypes = categories.join(' ');
    updateLearningContent(mode, categories);
    enhanceMcqs();
  }

  function initializeRad4NotesHeader() {
    moveHeaderControls();
    prepareSidebarNavigation();
    initializeCollapseButton();
    initializeLearningMode();
    applySidebarPreferences(readSidebarPreferences());
  }

  // Capture the action before Starlight's mobile-drawer click handler sees it.
  // This works for every responsive copy of the component.
  if (!document.documentElement.dataset.radHeaderEventsBound) {
    document.documentElement.dataset.radHeaderEventsBound = 'true';

    // Delegated change handling is essential here: Starlight can create or
    // clone the mobile header controls after the initial page script runs.
    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const modeSelector = target.closest('#rad-learning-mode');
      if (modeSelector) {
        setLearningMode(modeSelector.value);
        return;
      }

      const categoryCheckbox = target.closest(
        '#rad-learning-categories input[type="checkbox"]',
      );
      if (categoryCheckbox) {
        setLearningCategories(categoryCheckbox);
      }
    }, true);

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const collapseButton = target.closest('#rad-collapse-all');
      if (collapseButton) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        collapseAllSidebarSections();
        return;
      }

      if (target.closest('#rad-toggle-left')) {
        const preferences = readSidebarPreferences();
        preferences.left = !preferences.left;
        applySidebarPreferences(preferences);
        return;
      }

      if (target.closest('#rad-toggle-right')) {
        const preferences = readSidebarPreferences();
        preferences.right = !preferences.right;
        applySidebarPreferences(preferences);
      }
    }, true);
  }

  initializeRad4NotesHeader();
  document.addEventListener('astro:page-load', initializeRad4NotesHeader);
</script>
